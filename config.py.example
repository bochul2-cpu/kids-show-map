# config.py 파일을 이 이름으로 복사한 뒤, 본인의 인증키로 채워주세요.

# KOPIS 인증키 발급: https://kopis.or.kr/por/cs/openapi/openApiUseSend.do?menuId=MNU_00074
KOPIS_SERVICE_KEY = "여기에_발급받은_KOPIS_인증키"
KOPIS_BASE_URL = "http://www.kopis.or.kr/openApi/restful"

# NAVER API HUB - KOPIS 시설 좌표를 못 찾았을 때 시설명으로 대략 위치를 보정하는 용도
NAVER_API_URL = "https://naverapihub.apigw.ntruss.com/search/v1/local"
NAVER_HEADERS = {
    "X-NCP-APIGW-API-KEY-ID": "여기에_Client_ID",
    "X-NCP-APIGW-API-KEY": "여기에_Client_Secret",
}

# NCP Maps(Web Dynamic Map) 발급: console.ncloud.com > Application Services > Maps
NAVER_MAP_CLIENT_ID = "여기에_Maps_Client_ID"

SHOW_KEYWORDS = ["어린이", "아동", "키즈", "인형극"]

KOPIS_GENRES = ["AAAA", "GGGA", "EEEB"]  # 연극, 뮤지컬, 서커스/마술
KOPIS_REGION_CODES = ["11", "41"]  # 서울, 경기

DAYS_AHEAD = 90

ALLOWED_ADDRESS_PREFIXES = ("서울", "경기")

DATA_PATH = "data/places.json"
MAP_OUTPUT_PATH = "index.html"
